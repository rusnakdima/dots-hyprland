  "musicRecognition": {
    "timeout": 16,
    "interval": 4
  },
  "search": {
    "nonAppResultDelay": 30,
    "engineBaseUrl": "https://www.google.com/search?q=",
    "excludedSites": ["quora.com", "facebook.com"],
    "sloppy": false,
    "prefix": {
      "showDefaultActionsWithoutPrefix": true,
      "action": "/",
      "app": ">",
      "clipboard": ";",
      "emojis": ":",
      "math": "=",
      "shellCommand": "$",
      "webSearch": "?"
    },
    "imageSearch": {
      "imageSearchEngineBaseUrl": "https://lens.google.com/uploadbyurl?url=",
      "useCircleSelection": false
    }
  },
  "sidebar": {
    "keepRightSidebarLoaded": true,
    "translator": {
      "enable": false,
      "delay": 300
    },
    "ai": {
      "textFadeIn": false
    },
    "booru": {
      "allowNsfw": false,
      "defaultProvider": "yandere",
      "limit": 20,
      "zerochan": {
        "username": "[unset]"
      }
    },
    "cornerOpen": {
      "enable": true,
      "bottom": false,
      "valueScroll": true,
      "clickless": false,
      "cornerRegionWidth": 250,
      "cornerRegionHeight": 5,
      "visualize": false,
      "clicklessCornerEnd": true,
      "clicklessCornerVerticalOffset": 1
    },
    "quickToggles": {
      "style": "android",
      "android": {
        "columns": 5,
        "toggles": [
          { "size": 2, "type": "network" },
          { "size": 2, "type": "bluetooth" },
          { "size": 1, "type": "idleInhibitor" },
          { "size": 1, "type": "mic" },
          { "size": 2, "type": "audio" },
          { "size": 2, "type": "nightLight" }
