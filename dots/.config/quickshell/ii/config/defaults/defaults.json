      }
    },
    "quickSliders": {
      "enable": false,
      "showMic": false,
      "showVolume": true,
      "showBrightness": true,
      "showClipboard": true
    }
  },
  "screenRecord": {
    "savePath": ""
  },
  "screenSnip": {
    "savePath": ""
  },
  "sounds": {
    "battery": false,
    "pomodoro": false,
    "theme": "freedesktop"
  },
  "keybinds": {
    "disabled": []
  },
  "keyboard": {
    "layouts": ["us"],
    "rgb": [4, 4, 4]
  },
  "time": {
    "format": "hh:mm",
    "shortDateFormat": "dd/MM",
    "dateWithYearFormat": "dd/MM/yyyy",
    "dateFormat": "ddd, dd/MM",
    "pomodoro": {
      "breakTime": 300,
      "cyclesBeforeLongBreak": 4,
      "focus": 1500,
      "longBreak": 900
    },
    "secondPrecision": false
  },
  "updates": {
    "enableCheck": true,
    "checkInterval": 120,
    "adviseUpdateThreshold": 75,
    "stronglyAdviseUpdateThreshold": 200
  },
  "vision": {
    "confidenceThreshold": 0.5
